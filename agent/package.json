{
  "name": "@sovereignty-ai/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SovereigntyAI AI decision + execution-intent service. Analyzes real on-chain state and submits structured intents to execution-engine.clar for Clarity to independently validate.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --loader tsx src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@stacks/transactions": "^7.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.4.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
