# SovereigntyAI AI agent configuration.
# Copy to agent/.env and fill in real values. Never commit agent/.env.

NETWORK=testnet
STACKS_API_URL=https://api.testnet.hiro.so
PORT=4021

# The address that deployed the SovereigntyAI protocol contracts on this
# network (see scripts/deploy-testnet.ts / docs/deployment.md). Required
# for every contract call the agent makes.
DEPLOYER_ADDRESS=

# The real, currently-deployed sBTC token contract on Stacks Testnet.
# Verified via scripts/inspect-contracts.ts — do not change without
# re-verifying against https://docs.stacks.co and the live Testnet API.
SBTC_CONTRACT_ADDRESS=SN3VMHXEN64ZZF71JQ5VESXDWTR301XTTXGF4J8F1
SBTC_CONTRACT_NAME=sbtc-token

# TESTNET-ONLY private key for the AI executor identity. This account
# must be separately registered via agent-registry.register-executor by
# the protocol admin before the agent can execute anything. Generate a
# dedicated wallet for this — never reuse a personal or deployer key.
# NEVER commit this. NEVER set it in any client-visible environment.
EXECUTOR_PRIVATE_KEY=

# How many blocks in the future a submitted intent's deadline is set.
INTENT_DEADLINE_WINDOW_BLOCKS=20

# Optional. Enables LLM-assisted narration of recommendations (see
# src/analysis/llmNarrator.ts). Used ONLY to phrase the real, already
# pre-computed numbers into readable text -- the model never decides the
# action, amount, or any enforceable field, and the agent works fine
# without this key (falls back to deterministic canned text).
ANTHROPIC_API_KEY=
